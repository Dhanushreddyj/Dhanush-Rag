# RAG Service Environment Variables — copy to .env and fill in values.
# Do NOT commit this file with real credentials.

APP_NAME=RealEstateRAG
ENV=development

# ───────────── Provider Selection ─────────────
# Set these environment variables to switch providers.
# Supported: openai_compatible, bedrock (LLM)
# Supported: openai_compatible, bedrock (embedding)
# Supported: qdrant, chroma (vector store)

LLM_PROVIDER=openai_compatible
EMBEDDING_PROVIDER=openai_compatible
VECTOR_STORE_PROVIDER=qdrant

# ───────────── OpenAI-compatible API (e.g., LM Studio) ─────────────
OPENAI_BASE_URL=http://192.168.88.7:1234/v1
OPENAI_API_KEY=your-lm-studio-api-key
OPENAI_MODEL=qwen3.6-14-a3b-fablevibes@q4_k_m

# ───────────── Bedrock (AWS) — uncomment to use ─────────────
# LLM_PROVIDER=bedrock
# EMBEDDING_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=your-bedrock-model-id
# BEDROCK_EMBEDDING_MODEL_ID=your-bedrock-embedding-model-id

# ───────────── Qdrant — uncomment to use ─────────────
# VECTOR_STORE_PROVIDER=qdrant
# QDRANT_HOST=http://localhost:6041
# QDRANT_API_KEY=your-qdrant-api-key
# QDRANT_COLLECTION_NAME=my_documents

# ───────────── ChromaDB (local, dev only) ─────────────
# VECTOR_STORE_PROVIDER=chroma
# CHROMA_DIR=./data/chroma

# ───────────── RAG Parameters ─────────────
TOP_K=5
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_QUERY_LENGTH=3
MAX_QUERY_LENGTH=2048
MAX_CONTEXT_DOCS=10

# ───────────── Rate Limiting ─────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60.0

# ───────────── Caching ─────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
MAX_CACHE_SIZE=1000

# ───────────── Logging ─────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
